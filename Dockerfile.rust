# Rust API runtime with the existing React/Vite frontend
FROM node:22-alpine AS web-build
WORKDIR /app
COPY web /app/web
RUN corepack enable && cd /app/web && pnpm install --no-frozen-lockfile && pnpm build

FROM rust:1.100-bookworm AS rust-build
WORKDIR /app/rust-api
COPY rust-api/Cargo.toml rust-api/Cargo.lock ./
RUN cargo build --release || true
COPY rust-api/src ./src
RUN cargo build --release

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
ENV API_PORT=3000 API_LISTEN_ADDRESS=0.0.0.0 WEB_DIST_PATH=/app/web
WORKDIR /app
COPY --from=rust-build /app/rust-api/target/release/wittens-api /usr/local/bin/wittens-api
COPY --from=web-build /app/web/dist /app/web
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -qO- "http://127.0.0.1:${API_PORT}/api" >/dev/null || exit 1
CMD ["/usr/local/bin/wittens-api"]
