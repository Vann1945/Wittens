{
  "name": "wittens",
  "private": true,
  "description": "Paste a TikTok link, get the file, move on.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @wittens/api --filter @wittens/web dev",
    "dev:api": "pnpm --filter @wittens/api dev",
    "dev:web": "pnpm --filter @wittens/web dev",
    "build": "pnpm --filter @wittens/web build && pnpm --filter @wittens/api build",
    "start": "pnpm --filter @wittens/api start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
