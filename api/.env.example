# Copy to api/.env for local development. Every variable is optional.
# Full reference: docs/env-variables.md

API_PORT=3000
API_LISTEN_ADDRESS=127.0.0.1

# Set when running behind a reverse proxy (number of proxies in front of wittens).
# TRUST_PROXY=1

# Allow another origin to call the api from a browser. Leave unset for same-origin only.
# CORS_ORIGIN=https://wittens.example

# Serve the built web app from the api process (what the Docker image does).
# WEB_DIST_PATH=../web/dist
